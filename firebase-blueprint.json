{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account and learning profile",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "avatar": { "type": "string", "maxLength": 500 },
        "level": { "type": "string", "enum": ["A1", "A2", "B1", "B2", "C1", "C2"] },
        "goal": { "type": "string", "maxLength": 50 },
        "targetLanguage": { "type": "string", "maxLength": 50 },
        "nativeLanguage": { "type": "string", "maxLength": 50 },
        "streak": { "type": "number" },
        "xp": { "type": "number" },
        "dailyGoalMinutes": { "type": "number" },
        "completedTodayMinutes": { "type": "number" },
        "coins": { "type": "number" },
        "unlockedBadges": { "type": "array" },
        "weakAreas": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "level", "targetLanguage"]
    },
    "SavedWord": {
      "title": "SavedWord",
      "description": "A vocabulary word saved by the user",
      "type": "object",
      "properties": {
        "word": { "type": "string", "maxLength": 100 },
        "phonetic": { "type": "string", "maxLength": 100 },
        "definition": { "type": "string", "maxLength": 500 },
        "translation": { "type": "string", "maxLength": 500 },
        "example": { "type": "string", "maxLength": 1000 },
        "difficulty": { "type": "string", "maxLength": 20 },
        "mastery": { "type": "number" },
        "lastReviewedAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["word", "definition"]
    },
    "ConversationSession": {
      "title": "ConversationSession",
      "description": "An AI practice conversation session",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "mode": { "type": "string", "maxLength": 50 },
        "scenarioTitle": { "type": "string", "maxLength": 200 },
        "targetLanguage": { "type": "string", "maxLength": 50 },
        "messages": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "mode", "targetLanguage"]
    },
    "ChallengeAttempt": {
      "title": "ChallengeAttempt",
      "description": "A 30-second daily challenge attempt",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "topic": { "type": "string", "maxLength": 200 },
        "userText": { "type": "string", "maxLength": 2000 },
        "fluencyScore": { "type": "number" },
        "confidenceScore": { "type": "number" },
        "pronunciationScore": { "type": "number" },
        "grammarScore": { "type": "number" },
        "feedback": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "topic", "userText"]
    },
    "StreakLog": {
      "title": "StreakLog",
      "description": "Record of daily practice streak progress completion",
      "type": "object",
      "properties": {
        "streak": { "type": "number" },
        "xpGained": { "type": "number" },
        "coinsGained": { "type": "number" },
        "milestoneUnlocked": { "type": "string", "maxLength": 100 },
        "timestamp": { "type": "string" }
      },
      "required": ["streak", "xpGained"]
    },
    "UserAchievement": {
      "title": "UserAchievement",
      "description": "Unlocked badge or milestone achievement record",
      "type": "object",
      "properties": {
        "achievementId": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 150 },
        "badgeName": { "type": "string", "maxLength": 100 },
        "xp": { "type": "number" },
        "coins": { "type": "number" },
        "unlockedAt": { "type": "string" }
      },
      "required": ["achievementId", "title", "badgeName"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/entities/UserProfile",
      "description": "User profile records"
    },
    "/users/{userId}/savedWords/{wordId}": {
      "schema": "#/entities/SavedWord",
      "description": "Vocabulary items saved by user"
    },
    "/users/{userId}/conversations/{conversationId}": {
      "schema": "#/entities/ConversationSession",
      "description": "AI conversation history"
    },
    "/users/{userId}/challenges/{challengeId}": {
      "schema": "#/entities/ChallengeAttempt",
      "description": "Daily speaking challenge attempts"
    },
    "/users/{userId}/streakLogs/{logId}": {
      "schema": "#/entities/StreakLog",
      "description": "Daily practice streak completion records"
    },
    "/users/{userId}/achievements/{achievementId}": {
      "schema": "#/entities/UserAchievement",
      "description": "Unlocked user achievements and badges"
    }
  }
}
